#!/bin/sh
# Build the mod and package it, locally (nothing is uploaded anywhere):
# - dist/bismuth-VERSION.jar, the single-jar install (tools/bundle.py): the Metal mod, natives inside, with the fps counter
#   nested through Fabric's jar-in-jar. Put it in the mods folder; this build runs without Sodium.
# - dist/bismuth-VERSION.zip: bismuth-VERSION/{bismuth-VERSION.jar, README.txt, LICENSE, NOTICE}, the same jar byte for
#   byte (README.txt is RELEASE-README.txt with the version filled in).
# Usage: tools/release
set -eu
cd "$(dirname "$0")/.."
die() { echo "$*" >&2; exit 1; }
version=$(sed -n "s/^version = '\(.*\)'$/\1/p" metal/build.gradle)
[ -n "$version" ] || die "No version in metal/build.gradle."
./gradlew :metal:build :fpshud:build -q --console=plain
jar=metal/build/libs/bismuth-$version.jar
[ -f "$jar" ] || die "The build made no $jar."
fps=fpshud/build/libs/bismuth-fps-$version.jar
[ -f "$fps" ] || die "The build made no $fps."
name=bismuth-$version
mkdir -p dist
python3 tools/bundle.py --metal "$jar" --fps "$fps" --out "dist/bismuth-$version.jar"
rm -rf "dist/$name" "dist/$name.zip"
mkdir -p "dist/$name"
cp "dist/bismuth-$version.jar" "dist/$name/bismuth-$version.jar"
cp LICENSE NOTICE "dist/$name/"
sed "s/@VERSION@/$version/g" RELEASE-README.txt > "dist/$name/README.txt"
(cd dist && zip -qrX "$name.zip" "$name")
echo "dist/$name.zip"
